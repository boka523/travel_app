generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model trips {
  id             Int                  @id @default(autoincrement())
  user_id        Int
  destination    String               @db.VarChar(255)
  start_date     DateTime             @db.Date
  end_date       DateTime             @db.Date
  transport_type trips_transport_type
  total_cost     Decimal?             @default(0.00) @db.Decimal(10, 2)
  passengers_num Int
  ai_cost        Int?
  hotel_id       Int?
  users          users                @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "trips_ibfk_1")
  hotels         hotels?              @relation(fields: [hotel_id], references: [id], onUpdate: NoAction, map: "trips_ibfk_2")

  @@index([user_id], map: "user_id")
  @@index([hotel_id], map: "hotel_id")
}

model users {
  id            Int     @id @default(autoincrement())
  name          String  @db.VarChar(100)
  email         String  @unique(map: "email") @db.VarChar(255)
  password_hash String  @db.VarChar(255)
  profile_image String? @db.VarChar(255)
  trips         trips[]
}

model destination {
  id            Int     @id @default(autoincrement())
  hotelbedsCode String  @unique
  name          String
  countryCode   String?
}

model hotels {
  id                    Int      @id @default(autoincrement())
  hotelbedsCode         Int      @unique(map: "hotelbedsCode")
  name                  String   @db.VarChar(255)
  countryCode           String?  @db.VarChar(10)
  destinationCode       String?  @db.VarChar(20)
  address               String?  @db.VarChar(255)
  postalCode            String?  @db.VarChar(20)
  city                  String?  @db.VarChar(100)
  latitude              Decimal? @db.Decimal(10, 7)
  longitude             Decimal? @db.Decimal(10, 7)
  categoryCode          String?  @db.VarChar(20)
  categoryName          String?  @db.VarChar(100)
  stars                 Int?
  mainImagePath         String?  @db.VarChar(500)
  description           String?  @db.Text
  accommodationTypeCode String?  @db.VarChar(50)
  web                   String?  @db.VarChar(255)
  trips                 trips[]
}

model import_progress {
  id         Int     @id @default(autoincrement())
  importType String  @unique(map: "importType") @db.VarChar(50)
  nextFrom   Int
  completed  Boolean @default(false)
}

enum trips_transport_type {
  car
  plane
  boat
  bus
  train
}
